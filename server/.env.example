# Server environment variables
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/fixtogether

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Cloudinary (optional - falls back to local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Provider: 'mock' or 'openai'
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@fixtogether.com

# Maps (optional)
MAP_PROVIDER=openstreetmap
GEOCODING_API_KEY=
