# Server environment variables
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/fixtogether

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Client & Admin URLs (for Multi-Origin CORS & Single Sign-On SSO)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Web Push (VAPID Configuration for Background Service Worker Push Notifications)
# Generate via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@fixtogether.com

# Cloudinary Storage Configuration
# NOTE: In production (e.g., Render/Vercel/Docker), cloud storage is ENFORCED by default
# to prevent catastrophic media loss on ephemeral disks.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional overrides:
ENFORCE_CLOUD_STORAGE=true
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false

# AI Provider: 'mock' or 'openai'
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# Email / SMTP / Multi-Provider Configuration
# Choose one provider explicitly when more than one credential is present:
# EMAIL_PROVIDER=resend (default when RESEND_API_KEY is set)
# EMAIL_PROVIDER=sendgrid (default when SENDGRID_API_KEY is set)
# EMAIL_PROVIDER=smtp (default otherwise; use gmail for Gmail SMTP)
# Supported providers:
# 1) Resend (Recommended for cloud hosting - bypasses blocked SMTP ports):
# RESEND_API_KEY=re_123456789
# 2) SendGrid:
# SENDGRID_API_KEY=SG.123456789
# 3) Gmail SMTP (Requires 16-character Google App Password):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_16char_app_password
# 4) Standard SMTP (AWS SES, Mailgun, Postmark, Custom VPS):
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# Gmail SMTP is the default provider. Use a Google App Password for EMAIL_PASSWORD.
EMAIL_PROVIDER=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=FixTogether <your_email@gmail.com>

# Maps (optional)
MAP_PROVIDER=openstreetmap
GEOCODING_API_KEY=

# Rate Limiting (all values optional — sensible defaults used if omitted)
# General API: authenticated reads + browsing (default: 300 req / 15 min)
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_GENERAL_WINDOW_MS=900000
# Auth: login + registration (default: 10 req / 15 min)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
# Write operations: publish, messages, uploads (default: 30 req / 15 min)
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_WRITE_WINDOW_MS=900000
# AI analysis / chat (default: 5 req / 15 min)
RATE_LIMIT_AI_MAX=5
RATE_LIMIT_AI_WINDOW_MS=900000
