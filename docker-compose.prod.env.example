# Copy these entries into the project-root .env file for docker-compose.prod.yml.
# Do not commit the real .env file or paste secret values into documentation.

JWT_ACCESS_SECRET=generate-a-long-random-secret
JWT_REFRESH_SECRET=generate-a-different-long-random-secret

# The Compose MongoDB service is isolated on its private network by default.
MONGODB_URI=mongodb://mongodb:27017/fixtogether

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloud-api-key
CLOUDINARY_API_SECRET=your-cloud-api-secret

EMAIL_PROVIDER=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-account@gmail.com
EMAIL_PASSWORD=your-google-app-password
EMAIL_FROM=

AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key

# Keep an existing VAPID key pair stable; both values may be blank to disable push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@fixtogether.com

ACME_EMAIL=you@example.com
# Optional comma-separated list of additional trusted browser origins.
CORS_ALLOWED_ORIGINS=https://app.fixtogether.com,https://fixtogether.com,https://admin.fixtogether.com
